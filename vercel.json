{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/s%C3%B8lvhjerte",
      "destination": "/solvhjerte",
      "permanent": false
    },
    {
      "source": "/sølvhjerte",
      "destination": "/solvhjerte",
      "permanent": false
    },
    {
      "source": "/skole",
      "destination": "/solvhjerte",
      "permanent": false
    },
    {
      "source": "/schools",
      "destination": "/silverheart",
      "permanent": false
    },
    {
      "source": "/retailers",
      "destination": "/vendor",
      "permanent": false
    },
    {
      "source": "/bransjekveld",
      "destination": "/forhandler",
      "permanent": false
    },
    {
      "source": "/files/kr1-dtrpg-launch-kit.pdf",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/img/launch-kit.jpg",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/img/email-launch-kit.jpg",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/free",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/shop",
      "destination": "https://www.drivethrurpg.com/en/publisher/15347/karl-otto-kristoffersen?src=web_redirect_shop&affiliate_id=927841",
      "permanent": false
    },
    {
      "source": "/product-page/:slug*",
      "destination": "https://www.drivethrurpg.com/en/publisher/15347/karl-otto-kristoffersen?src=web_redirect_product&affiliate_id=927841",
      "permanent": false
    },
    {
      "source": "/general-5",
      "destination": "/#story",
      "permanent": false
    },
    {
      "source": "/contact-8",
      "destination": "/#story",
      "permanent": false
    },
    {
      "source": "/faq",
      "destination": "/#faq",
      "permanent": false
    },
    {
      "source": "/downloads-refunds",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/store-policy",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/files/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}